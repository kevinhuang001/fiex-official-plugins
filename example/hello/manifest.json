{
  "schemaVersion": 2,
  "id": "org.example.hello",
  "name": "示例插件",
  "version": "0.1.0",
  "description": "连接、装饰和工具栏的新手示例。",
  "icon": "puzzle",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "5.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-example.exe",
      "macos-aarch64": "fiex-plugin-example",
      "macos-x86_64": "fiex-plugin-example",
      "linux-x86_64": "fiex-plugin-example"
    }
  },
  "permissions": {
    "metadata": {
      "enabled": true
    },
    "folders": {
      "read": {
        "enabled": true
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "network": {
      "enabled": false,
      "domains": []
    },
    "commands": {
      "enabled": false,
      "allow": []
    },
    "hooks": {
      "enabled": true
    }
  },
  "extensions": {
    "connections": {
      "title": "示例文件",
      "fields": [
        {
          "id": "server",
          "label": "服务器地址",
          "type": "text",
          "required": true,
          "placeholder": "demo.example.com"
        }
      ]
    },
    "vfs": {
      "title": "示例文件",
      "readOnly": true
    },
    "decorations": {
      "match": {
        "extensions": [
          "md",
          "txt"
        ],
        "kinds": [
          "file"
        ]
      },
      "priority": 80
    },
    "toolbar": {
      "title": "示例插件",
      "icon": "puzzle",
      "panel": {
        "entry": "ui/index.html",
        "title": "示例插件",
        "defaultSize": {
          "width": 460,
          "height": 340
        }
      }
    },
    "contextMenus": {
      "match": {
        "extensions": [
          "txt",
          "md",
          "log"
        ],
        "kinds": [
          "file"
        ],
        "selection": "single"
      }
    },
    "info": {
      "priority": 80,
      "match": {
        "extensions": [
          "txt",
          "md",
          "log"
        ],
        "kinds": [
          "file"
        ]
      }
    },
    "preview": {
      "priority": 60,
      "match": {
        "extensions": [
          "txt",
          "md",
          "log"
        ],
        "kinds": [
          "file"
        ]
      }
    },
    "search": {
      "icon": "magnifying-glass"
    },
    "settings": [
      {
        "id": "greeting",
        "label": "问候语",
        "type": "text",
        "defaultValue": "你好"
      }
    ],
    "hooks": {
      "event": "beforeOpen",
      "priority": 100,
      "extensions": [
        "txt",
        "md"
      ]
    }
  }
}
