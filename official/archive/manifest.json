{
  "schemaVersion": 1,
  "id": "org.fiex.archive",
  "name": "压缩与解压",
  "version": "0.2.4",
  "description": "压缩与解压 ZIP、RAR、7z、TAR 等格式。",
  "icon": "archive",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "2.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-archive.exe",
      "macos-aarch64": "fiex-plugin-archive",
      "macos-x86_64": "fiex-plugin-archive",
      "linux-x86_64": "fiex-plugin-archive"
    }
  },
  "permissions": {
    "filesystem": {
      "read": true,
      "write": true
    },
    "network": {
      "enabled": false,
      "domains": []
    }
  },
  "contributions": {
    "contextMenus": [
      {
        "id": "archive.compress",
        "title": "压缩",
        "when": "context.selection.isNotArchive",
        "children": [
          {
            "id": "archive.zip",
            "title": "ZIP",
            "command": "archive.compress",
            "args": {
              "format": "zip"
            }
          },
          {
            "id": "archive.rar",
            "title": "RAR",
            "command": "archive.compress",
            "args": {
              "format": "rar"
            }
          },
          {
            "id": "archive.7z",
            "title": "7z",
            "command": "archive.compress",
            "args": {
              "format": "7z"
            }
          },
          {
            "id": "archive.tar",
            "title": "TAR",
            "command": "archive.compress",
            "args": {
              "format": "tar"
            }
          },
          {
            "id": "archive.tar.gz",
            "title": "TAR.GZ",
            "command": "archive.compress",
            "args": {
              "format": "tar.gz"
            }
          },
          {
            "id": "archive.tar.bz2",
            "title": "TAR.BZ2",
            "command": "archive.compress",
            "args": {
              "format": "tar.bz2"
            }
          },
          {
            "id": "archive.tar.xz",
            "title": "TAR.XZ",
            "command": "archive.compress",
            "args": {
              "format": "tar.xz"
            }
          },
          {
            "id": "archive.advanced",
            "title": "高级压缩…",
            "panel": {
              "entry": "ui/dist/index.html",
              "title": "高级压缩"
            }
          }
        ]
      },
      {
        "id": "archive.extract",
        "title": "解压缩",
        "when": "context.selection.isArchive",
        "command": "archive.extract"
      }
    ],
    "decorations": {
      "mode": "declarative",
      "priority": 10,
      "rules": [
        {
          "match": {
            "isDir": false,
            "extensions": [
              "zip"
            ]
          },
          "badge": {
            "text": "ZIP",
            "color": "neutral"
          }
        },
        {
          "match": {
            "isDir": false,
            "extensions": [
              "rar"
            ]
          },
          "badge": {
            "text": "RAR",
            "color": "neutral"
          }
        },
        {
          "match": {
            "isDir": false,
            "extensions": [
              "7z"
            ]
          },
          "badge": {
            "text": "7Z",
            "color": "neutral"
          }
        },
        {
          "match": {
            "isDir": false,
            "extensions": [
              "tar"
            ]
          },
          "badge": {
            "text": "TAR",
            "color": "neutral"
          }
        },
        {
          "match": {
            "isDir": false,
            "extensions": [
              "gz",
              "tgz"
            ]
          },
          "badge": {
            "text": "TGZ",
            "color": "neutral"
          }
        },
        {
          "match": {
            "isDir": false,
            "extensions": [
              "bz2",
              "tbz2"
            ]
          },
          "badge": {
            "text": "TBZ",
            "color": "neutral"
          }
        },
        {
          "match": {
            "isDir": false,
            "extensions": [
              "xz",
              "txz"
            ]
          },
          "badge": {
            "text": "TXZ",
            "color": "neutral"
          }
        }
      ]
    }
  }
}
