{
  "schemaVersion": 1,
  "id": "org.fiex.archive",
  "name": "压缩与解压",
  "version": "0.2.0",
  "description": "压缩与解压 ZIP、RAR、7z、TAR 等格式。",
  "icon": "archive",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "2.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-archive.exe",
      "macos-aarch64": "fiex-plugin-archive",
      "macos-x86_64": "fiex-plugin-archive",
      "linux-x86_64": "fiex-plugin-archive"
    }
  },
  "permissions": {
    "filesystem": {
      "read": true,
      "write": true
    },
    "network": {
      "enabled": false,
      "domains": []
    }
  },
  "contributions": {
    "toolbar": [
      {
        "id": "archive.main",
        "title": "压缩与解压",
        "icon": "archive",
        "panel": {
          "title": "压缩与解压",
          "entry": "ui/dist/index.html",
          "defaultSize": {
            "width": 630,
            "height": 520
          }
        }
      }
    ],
    "contextMenus": [
      {
        "id": "archive.compress",
        "title": "压缩为…",
        "when": "context.selection.count > 0",
        "children": [
          {
            "id": "archive.zip",
            "title": "ZIP",
            "command": "archive.compress",
            "args": {
              "format": "zip"
            },
            "picker": {
              "mode": "saveFile",
              "suggestedName": "Archive.zip",
              "extensions": [
                "zip"
              ],
              "param": "destination"
            }
          },
          {
            "id": "archive.rar",
            "title": "RAR",
            "command": "archive.compress",
            "args": {
              "format": "rar"
            },
            "picker": {
              "mode": "saveFile",
              "suggestedName": "Archive.rar",
              "extensions": [
                "rar"
              ],
              "param": "destination"
            }
          },
          {
            "id": "archive.7z",
            "title": "7z",
            "command": "archive.compress",
            "args": {
              "format": "7z"
            },
            "picker": {
              "mode": "saveFile",
              "suggestedName": "Archive.7z",
              "extensions": [
                "7z"
              ],
              "param": "destination"
            }
          },
          {
            "id": "archive.tar",
            "title": "TAR",
            "command": "archive.compress",
            "args": {
              "format": "tar"
            },
            "picker": {
              "mode": "saveFile",
              "suggestedName": "Archive.tar",
              "extensions": [
                "tar"
              ],
              "param": "destination"
            }
          },
          {
            "id": "archive.tar.gz",
            "title": "TAR.GZ",
            "command": "archive.compress",
            "args": {
              "format": "tar.gz"
            },
            "picker": {
              "mode": "saveFile",
              "suggestedName": "Archive.tar.gz",
              "extensions": [
                "gz"
              ],
              "param": "destination"
            }
          },
          {
            "id": "archive.tar.bz2",
            "title": "TAR.BZ2",
            "command": "archive.compress",
            "args": {
              "format": "tar.bz2"
            },
            "picker": {
              "mode": "saveFile",
              "suggestedName": "Archive.tar.bz2",
              "extensions": [
                "bz2"
              ],
              "param": "destination"
            }
          },
          {
            "id": "archive.tar.xz",
            "title": "TAR.XZ",
            "command": "archive.compress",
            "args": {
              "format": "tar.xz"
            },
            "picker": {
              "mode": "saveFile",
              "suggestedName": "Archive.tar.xz",
              "extensions": [
                "xz"
              ],
              "param": "destination"
            }
          }
        ]
      },
      {
        "id": "archive.extract",
        "title": "解压缩到…",
        "when": "context.selection.isFile",
        "command": "archive.extract",
        "picker": {
          "mode": "openDirectory",
          "param": "destination"
        }
      },
      {
        "id": "archive.advanced",
        "title": "高级压缩…",
        "when": "context.selection.count > 0",
        "panel": {
          "title": "高级压缩",
          "entry": "ui/dist/index.html",
          "defaultSize": {
            "width": 630,
            "height": 520
          }
        }
      }
    ]
  }
}
