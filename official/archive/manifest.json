{
  "schemaVersion": 2,
  "id": "org.fiex.archive",
  "name": "压缩与解压",
  "version": "0.3.5",
  "description": "压缩与解压 ZIP、RAR、7z、TAR 等格式。",
  "icon": "archive",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "6.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-archive.exe",
      "macos-aarch64": "fiex-plugin-archive",
      "macos-x86_64": "fiex-plugin-archive",
      "linux-x86_64": "fiex-plugin-archive"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": true
      },
      "create": {
        "enabled": true
      },
      "delete": {
        "enabled": true
      },
      "rename": {
        "enabled": true
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": true
      },
      "create": {
        "enabled": true
      },
      "delete": {
        "enabled": true
      },
      "rename": {
        "enabled": true
      }
    },
    "network": {
      "enabled": false,
      "domains": []
    },
    "commands": {
      "enabled": false,
      "allow": []
    },
    "hooks": {
      "enabled": true
    },
    "metadata": {
      "enabled": true
    }
  },
  "extensions": {
    "contextMenus": true,
    "settings": [
      {
        "id": "compressIgnores",
        "label": "压缩时忽略的文件或目录",
        "type": "list",
        "placeholder": ".git",
        "defaultValue": [
          ".git",
          "node_modules"
        ]
      },
      {
        "id": "extractMaxTotalGiB",
        "label": "解压输出上限（GiB）",
        "type": "number",
        "defaultValue": 20
      },
      {
        "id": "extractIgnores",
        "label": "解压时忽略的文件或目录",
        "type": "list",
        "placeholder": "__MACOSX",
        "defaultValue": [
          "__MACOSX"
        ]
      }
    ],
    "hooks": {
      "event": "beforeOpen",
      "priority": 100,
      "match": {
        "extensions": [
          "zip",
          "rar",
          "7z",
          "tar",
          "gz",
          "tgz",
          "bz2",
          "tbz2",
          "xz",
          "txz"
        ],
        "requiredOps": [
          "read"
        ]
      }
    },
    "preview": {
      "priority": 100,
      "match": {
        "extensions": [
          "zip",
          "rar",
          "7z",
          "tar",
          "gz",
          "tgz",
          "bz2",
          "tbz2",
          "xz",
          "txz"
        ],
        "requiredOps": [
          "read"
        ]
      },
      "loading": {
        "entry": "ui/dist/loading.html"
      }
    },
    "info": {
      "priority": 100,
      "match": {
        "extensions": [
          "zip",
          "7z",
          "rar",
          "tar",
          "gz",
          "tgz",
          "bz2",
          "tbz2",
          "xz",
          "txz"
        ],
        "requiredOps": [
          "read"
        ]
      }
    },
    "decorations": {
      "match": {
        "extensions": [
          "zip",
          "rar",
          "7z",
          "tar",
          "gz",
          "tgz",
          "bz2",
          "tbz2",
          "xz",
          "txz"
        ],
        "kinds": [
          "file"
        ]
      },
      "priority": 10
    },
    "ui": {
      "timeoutMs": 300000
    }
  },
  "locales": {
    "en": {
      "压缩与解压": "Compress & Extract",
      "压缩与解压 ZIP、RAR、7z、TAR 等格式。": "Compress and extract ZIP, RAR, 7z, TAR and other archives.",
      "压缩时忽略的文件或目录": "Files or directories to ignore when compressing",
      "解压时忽略的文件或目录": "Files or directories to ignore when extracting",
      "解压输出上限（GiB）": "Maximum extracted size (GiB)"
    },
    "zh-TW": {
      "压缩与解压": "壓縮與解壓",
      "压缩与解压 ZIP、RAR、7z、TAR 等格式。": "壓縮與解壓 ZIP、RAR、7z、TAR 等格式。",
      "压缩时忽略的文件或目录": "壓縮時忽略的檔案或目錄",
      "解压时忽略的文件或目录": "解壓時忽略的檔案或目錄",
      "解压输出上限（GiB）": "解壓輸出上限（GiB）"
    }
  }
}
