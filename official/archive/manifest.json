{
  "schemaVersion": 2,
  "id": "org.fiex.archive",
  "name": "压缩与解压",
  "version": "0.3.0",
  "description": "压缩与解压 ZIP、RAR、7z、TAR 等格式。",
  "icon": "archive",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "3.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-archive.exe",
      "macos-aarch64": "fiex-plugin-archive",
      "macos-x86_64": "fiex-plugin-archive",
      "linux-x86_64": "fiex-plugin-archive"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": true,
        "decorations": {
          "mode": "declarative",
          "priority": 10,
          "rules": [
            {
              "match": {
                "isDir": false,
                "extensions": [
                  "zip"
                ]
              },
              "badge": {
                "text": "ZIP",
                "color": "neutral"
              }
            },
            {
              "match": {
                "isDir": false,
                "extensions": [
                  "rar"
                ]
              },
              "badge": {
                "text": "RAR",
                "color": "neutral"
              }
            },
            {
              "match": {
                "isDir": false,
                "extensions": [
                  "7z"
                ]
              },
              "badge": {
                "text": "7Z",
                "color": "neutral"
              }
            },
            {
              "match": {
                "isDir": false,
                "extensions": [
                  "tar"
                ]
              },
              "badge": {
                "text": "TAR",
                "color": "neutral"
              }
            },
            {
              "match": {
                "isDir": false,
                "extensions": [
                  "gz",
                  "tgz"
                ]
              },
              "badge": {
                "text": "TGZ",
                "color": "neutral"
              }
            },
            {
              "match": {
                "isDir": false,
                "extensions": [
                  "bz2",
                  "tbz2"
                ]
              },
              "badge": {
                "text": "TBZ",
                "color": "neutral"
              }
            },
            {
              "match": {
                "isDir": false,
                "extensions": [
                  "xz",
                  "txz"
                ]
              },
              "badge": {
                "text": "TXZ",
                "color": "neutral"
              }
            }
          ]
        }
      },
      "create": {
        "enabled": true
      },
      "delete": {
        "enabled": true
      },
      "rename": {
        "enabled": true
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": true
      },
      "create": {
        "enabled": true
      },
      "delete": {
        "enabled": true
      },
      "rename": {
        "enabled": true
      }
    },
    "network": {
      "enabled": false,
      "domains": []
    },
    "commands": {
      "enabled": false,
      "allow": []
    },
    "hooks": {
      "enabled": true
    },
    "metadata": {
      "enabled": true
    }
  },
  "extensions": {
    "contextMenus": true,
    "settings": [
      {
        "id": "compressIgnores",
        "label": "压缩时忽略的文件或目录",
        "type": "list",
        "placeholder": ".git",
        "defaultValue": [
          ".git",
          "node_modules"
        ]
      },
      {
        "id": "extractMaxTotalGiB",
        "label": "解压输出上限（GiB）",
        "type": "number",
        "defaultValue": 20
      },
      {
        "id": "extractIgnores",
        "label": "解压时忽略的文件或目录",
        "type": "list",
        "placeholder": "__MACOSX",
        "defaultValue": [
          "__MACOSX"
        ]
      }
    ],
    "hooks": [
      {
        "id": "beforeOpen",
        "event": "beforeOpen",
        "method": "archive.beforeOpen",
        "priority": 100,
        "extensions": [
          "zip",
          "rar",
          "7z",
          "tar",
          "gz",
          "tgz",
          "bz2",
          "tbz2",
          "xz",
          "txz"
        ]
      }
    ],
    "preview": [
      {
        "id": "archive",
        "title": "压缩包预览",
        "extensions": [
          "zip",
          "rar",
          "7z",
          "tar",
          "gz",
          "tgz",
          "bz2",
          "tbz2",
          "xz",
          "txz"
        ],
        "priority": 100,
        "panel": {
          "entry": "ui/preview.html",
          "title": "压缩包预览",
          "defaultSize": {
            "width": 640,
            "height": 520
          }
        }
      }
    ],
    "info": [
      {
        "id": "archive.info",
        "title": "压缩包",
        "command": "archive.info",
        "extensions": [
          "zip",
          "7z",
          "rar",
          "tar",
          "gz",
          "tgz",
          "bz2",
          "tbz2",
          "xz",
          "txz"
        ],
        "priority": 100
      }
    ]
  }
}
