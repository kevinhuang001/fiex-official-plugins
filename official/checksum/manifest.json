{
  "schemaVersion": 1,
  "id": "org.fiex.checksum",
  "name": "校验和",
  "version": "0.2.3",
  "description": "计算 SHA-256、SHA-512、SHA-1、MD5 与 CRC32。",
  "icon": "hash",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "2.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-checksum.exe",
      "macos-aarch64": "fiex-plugin-checksum",
      "macos-x86_64": "fiex-plugin-checksum",
      "linux-x86_64": "fiex-plugin-checksum"
    }
  },
  "permissions": {
    "filesystem": {
      "read": true,
      "write": false
    },
    "network": {
      "enabled": false,
      "domains": []
    }
  },
  "contributions": {
    "contextMenus": [
      {
        "id": "checksum.calculate",
        "title": "查看校验和",
        "when": "context.selection.isFile",
        "panel": {
          "title": "校验和",
          "entry": "ui/dist/index.html",
          "defaultSize": {
            "width": 540,
            "height": 520
          }
        }
      }
    ]
  }
}
