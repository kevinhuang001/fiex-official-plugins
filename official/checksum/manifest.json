{
  "schemaVersion": 2,
  "id": "org.fiex.checksum",
  "name": "校验和",
  "version": "0.2.13",
  "description": "计算 SHA-256、SHA-512、SHA-1、MD5 与 CRC32。",
  "icon": "hash",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "7.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-checksum.exe",
      "macos-aarch64": "fiex-plugin-checksum",
      "macos-x86_64": "fiex-plugin-checksum",
      "linux-x86_64": "fiex-plugin-checksum"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": true
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "network": {
      "enabled": false,
      "domains": []
    },
    "commands": {
      "enabled": false,
      "allow": []
    },
    "metadata": {
      "enabled": true
    }
  },
  "extensions": {
    "info": {
      "priority": 100,
      "match": {
        "extensions": [],
        "kinds": [
          "file"
        ]
      },
      "sections": [
        {
          "id": "checksums",
          "title": "校验和",
          "fields": [
            {
              "id": "sha256",
              "label": "SHA-256",
              "compute": "onDemand"
            },
            {
              "id": "sha512",
              "label": "SHA-512",
              "compute": "onDemand"
            },
            {
              "id": "sha1",
              "label": "SHA-1",
              "compute": "onDemand"
            },
            {
              "id": "md5",
              "label": "MD5",
              "compute": "onDemand"
            },
            {
              "id": "crc32",
              "label": "CRC32",
              "compute": "onDemand"
            }
          ]
        }
      ]
    }
  },
  "locales": {
    "en": {
      "校验和": "Checksums",
      "计算 SHA-256、SHA-512、SHA-1、MD5 与 CRC32。": "Calculate SHA-256, SHA-512, SHA-1, MD5 and CRC32 checksums.",
      "SHA-256": "SHA-256",
      "SHA-512": "SHA-512",
      "SHA-1": "SHA-1",
      "MD5": "MD5",
      "CRC32": "CRC32"
    },
    "zh-TW": {
      "校验和": "校驗和",
      "计算 SHA-256、SHA-512、SHA-1、MD5 与 CRC32。": "計算 SHA-256、SHA-512、SHA-1、MD5 與 CRC32。",
      "SHA-256": "SHA-256",
      "SHA-512": "SHA-512",
      "SHA-1": "SHA-1",
      "MD5": "MD5",
      "CRC32": "CRC32"
    }
  }
}
