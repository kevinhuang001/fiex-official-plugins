{
  "schemaVersion": 2,
  "id": "org.fiex.data-preview",
  "name": "数据预览",
  "version": "0.4.5",
  "description": "表格数据的只读预览：SQLite、CSV/TSV、Excel、Parquet、Arrow IPC、Avro，支持分页与排序。",
  "icon": "database",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "8.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-data-preview.exe",
      "macos-aarch64": "fiex-plugin-data-preview",
      "macos-x86_64": "fiex-plugin-data-preview",
      "linux-x86_64": "fiex-plugin-data-preview"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "network": {
      "enabled": false,
      "domains": []
    },
    "commands": {
      "enabled": false,
      "allow": []
    },
    "metadata": {
      "enabled": true
    }
  },
  "extensions": {
    "preview": {
      "priority": 110,
      "maxBytes": 268435456,
      "match": {
        "extensions": [
          "db",
          "sqlite",
          "sqlite3",
          "csv",
          "tsv",
          "xlsx",
          "xls",
          "parquet",
          "arrow",
          "feather",
          "ipc",
          "avro"
        ]
      },
      "loading": {
        "entry": "ui/dist/loading.html"
      }
    },
    "info": {
      "priority": 100,
      "match": {
        "extensions": [
          "db",
          "sqlite",
          "sqlite3",
          "csv",
          "tsv",
          "xlsx",
          "xls",
          "parquet",
          "arrow",
          "feather",
          "ipc",
          "avro"
        ]
      },
      "title": "数据表",
      "subsections": [
        {
          "id": "data",
          "fields": [
            {
              "id": "format",
              "label": "格式",
              "compute": "onOpen"
            },
            {
              "id": "datasets",
              "label": "数据集",
              "compute": "onDemand"
            },
            {
              "id": "columns",
              "label": "首表列数",
              "compute": "onDemand"
            },
            {
              "id": "rows",
              "label": "首表行数",
              "compute": "onDemand"
            }
          ]
        }
      ]
    }
  },
  "locales": {
    "en": {
      "数据预览": "Data Preview",
      "表格数据的只读预览：SQLite、CSV/TSV、Excel、Parquet、Arrow IPC、Avro，支持分页与排序。": "Read-only preview of SQLite, CSV/TSV, Excel, Parquet, Arrow IPC and Avro, with pagination and sorting.",
      "数据表": "Data",
      "格式": "Format",
      "数据集": "Datasets",
      "首表列数": "Columns in first dataset",
      "首表行数": "Rows in first dataset"
    },
    "zh-TW": {
      "数据预览": "資料預覽",
      "表格数据的只读预览：SQLite、CSV/TSV、Excel、Parquet、Arrow IPC、Avro，支持分页与排序。": "表格資料的唯讀預覽：SQLite、CSV/TSV、Excel、Parquet、Arrow IPC、Avro，支援分頁與排序。",
      "数据表": "資料表",
      "格式": "格式",
      "数据集": "資料集",
      "首表列数": "首個資料集欄數",
      "首表行数": "首個資料集資料列數"
    }
  }
}
