{
  "schemaVersion": 2,
  "id": "org.fiex.email",
  "name": "Email",
  "version": "0.1.1",
  "description": "通过 IMAP/SMTP 连接邮箱，在 Fiex 中收发邮件。",
  "icon": "mail",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "6.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-email.exe",
      "macos-aarch64": "fiex-plugin-email",
      "macos-x86_64": "fiex-plugin-email",
      "linux-x86_64": "fiex-plugin-email"
    }
  },
  "permissions": {
    "network": {
      "enabled": true,
      "domains": [
        "imap.qq.com",
        "smtp.qq.com"
      ]
    }
  },
  "extensions": {
    "connections": {
      "title": "邮箱",
      "fields": [
        {
          "id": "email",
          "label": "邮箱地址",
          "type": "text",
          "required": true,
          "placeholder": "you@example.com"
        },
        {
          "id": "password",
          "label": "IMAP/SMTP 授权码",
          "type": "secret",
          "required": true
        },
        {
          "id": "imapHost",
          "label": "IMAP 服务器",
          "type": "text",
          "defaultValue": "imap.qq.com"
        },
        {
          "id": "smtpHost",
          "label": "SMTP 服务器",
          "type": "text",
          "defaultValue": "smtp.qq.com"
        }
      ]
    }
  },
  "locales": {
    "en": {
      "IMAP 服务器": "IMAP server",
      "IMAP/SMTP 授权码": "IMAP/SMTP app password",
      "SMTP 服务器": "SMTP server",
      "通过 IMAP/SMTP 连接邮箱，在 Fiex 中收发邮件。": "Connect to email via IMAP/SMTP and send or receive messages in Fiex.",
      "邮箱": "Mail",
      "邮箱地址": "Email address"
    },
    "zh-TW": {
      "IMAP 服务器": "IMAP 伺服器",
      "IMAP/SMTP 授权码": "IMAP/SMTP 授權碼",
      "SMTP 服务器": "SMTP 伺服器",
      "通过 IMAP/SMTP 连接邮箱，在 Fiex 中收发邮件。": "透過 IMAP/SMTP 連線至信箱，在 Fiex 中收發郵件。",
      "邮箱": "信箱",
      "邮箱地址": "電子郵件地址"
    }
  }
}
