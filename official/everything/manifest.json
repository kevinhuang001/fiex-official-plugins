{
  "schemaVersion": 1,
  "id": "org.fiex.everything",
  "name": "Everything 搜索",
  "version": "0.2.7",
  "description": "通过宿主调用 PATH 中的 ES 命令查询 Everything 索引；需要安装并运行 Everything 和 ES。",
  "icon": "magnifying-glass",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "2.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-everything.exe"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": true
      },
      "create": false,
      "delete": false,
      "rename": false
    },
    "files": {
      "read": true,
      "write": false
    },
    "network": {
      "enabled": false,
      "domains": []
    },
    "commands": {
      "enabled": true,
      "allow": ["es"]
    }
  },
  "contributions": {
    "search": [
      {
        "id": "everything",
        "title": "Everything",
        "icon": "magnifying-glass",
        "scope": "global",
        "command": "search.query"
      }
    ]
  }
}
