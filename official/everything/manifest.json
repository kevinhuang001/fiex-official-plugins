{
  "schemaVersion": 1,
  "id": "org.fiex.everything",
  "name": "Everything 搜索",
  "version": "0.2.7",
  "description": "借用 Everything 的本地索引提供秒级文件名搜索（Windows）。",
  "icon": "magnifying-glass",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "2.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-everything.exe"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": true
      },
      "write": false
    },
    "files": {
      "read": true,
      "write": false
    },
    "network": {
      "enabled": false,
      "domains": []
    },
    "commands": {
      "enabled": false,
      "allow": []
    }
  },
  "contributions": {
    "search": [
      {
        "id": "everything",
        "title": "Everything",
        "icon": "magnifying-glass",
        "scope": "global",
        "command": "search.query"
      }
    ]
  }
}
