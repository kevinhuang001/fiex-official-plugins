{
  "schemaVersion": 2,
  "id": "org.fiex.everything",
  "name": "Everything 搜索",
  "version": "0.2.11",
  "description": "通过宿主调用 PATH 中的 ES 命令查询 Everything 索引；需要安装并运行 Everything 和 ES。",
  "icon": "magnifying-glass",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "6.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-everything.exe"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": true
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "network": {
      "enabled": false,
      "domains": []
    },
    "commands": {
      "enabled": true,
      "allow": [
        "es"
      ]
    },
    "metadata": {
      "enabled": true
    }
  },
  "extensions": {
    "search": {
      "icon": "magnifying-glass",
      "priority": 80,
      "modes": [
        "name"
      ],
      "match": {
        "storage": {
          "providerIds": [
            "core:local-fs"
          ]
        },
        "kinds": [
          "directory"
        ]
      }
    }
  },
  "locales": {
    "en": {
      "Everything 搜索": "Everything Search",
      "通过宿主调用 PATH 中的 ES 命令查询 Everything 索引；需要安装并运行 Everything 和 ES。": "Search the Everything index through the ES executable on the host PATH; Everything and ES must be installed and running."
    },
    "zh-TW": {
      "Everything 搜索": "Everything 搜尋",
      "通过宿主调用 PATH 中的 ES 命令查询 Everything 索引；需要安装并运行 Everything 和 ES。": "透過主程式呼叫 PATH 中的 ES 指令查詢 Everything 索引；須安裝並執行 Everything 和 ES。"
    }
  }
}
