{
  "schemaVersion": 2,
  "id": "org.fiex.git",
  "name": "Git",
  "version": "0.2.12",
  "description": "源代码管理、提交历史、远程仓库与只读历史浏览。",
  "icon": "git-branch",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "6.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-git.exe",
      "macos-aarch64": "fiex-plugin-git",
      "macos-x86_64": "fiex-plugin-git",
      "linux-x86_64": "fiex-plugin-git"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": true
      },
      "create": {
        "enabled": true
      },
      "delete": {
        "enabled": true
      },
      "rename": {
        "enabled": true
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": true
      },
      "create": {
        "enabled": true
      },
      "delete": {
        "enabled": true
      },
      "rename": {
        "enabled": true
      }
    },
    "network": {
      "enabled": true,
      "domains": [
        "github.com"
      ]
    },
    "commands": {
      "enabled": true,
      "allow": [
        "git"
      ]
    },
    "metadata": {
      "enabled": true
    }
  },
  "extensions": {
    "toolbar": {
      "title": "源代码管理",
      "icon": "git-branch",
      "panel": {
        "title": "源代码管理",
        "entry": "ui/dist/index.html",
        "defaultSize": {
          "width": 480,
          "height": 300
        }
      }
    },
    "settings": [
      {
        "id": "historyLimit",
        "label": "历史提交显示条数",
        "type": "number",
        "defaultValue": "50"
      }
    ],
    "vfs": {
      "title": "Git 历史",
      "readOnly": true
    },
    "decorations": {
      "priority": 50
    }
  },
  "locales": {
    "en": {
      "Git 历史": "Git History",
      "历史提交显示条数": "Commit history limit",
      "源代码管理": "Source Control",
      "源代码管理、提交历史、远程仓库与只读历史浏览。": "Source control, commit history, remote repositories and read-only history browsing."
    },
    "zh-TW": {
      "Git 历史": "Git 歷史",
      "历史提交显示条数": "歷史提交顯示筆數",
      "源代码管理": "原始碼管理",
      "源代码管理、提交历史、远程仓库与只读历史浏览。": "原始碼管理、提交歷史、遠端儲存庫與唯讀歷史瀏覽。"
    }
  }
}
