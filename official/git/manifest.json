{
  "schemaVersion": 1,
  "id": "org.fiex.git",
  "name": "Git",
  "version": "0.1.1",
  "description": "源代码管理、提交历史、远程仓库与只读历史浏览。",
  "icon": "git-branch",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "2.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-git.exe",
      "macos-aarch64": "fiex-plugin-git",
      "macos-x86_64": "fiex-plugin-git",
      "linux-x86_64": "fiex-plugin-git"
    }
  },
  "permissions": {
    "filesystem": {
      "read": true,
      "write": true
    },
    "network": {
      "enabled": true,
      "domains": [
        "github.com"
      ]
    },
    "commands": {
      "enabled": true,
      "allow": [
        "git"
      ]
    }
  },
  "contributions": {
    "toolbar": [
      {
        "id": "git.main",
        "title": "源代码管理",
        "icon": "git-branch",
        "command": "git.status",
        "schemes": [
          "history"
        ]
      }
    ],
    "settings": [
      {
        "id": "historyLimit",
        "label": "历史提交显示条数",
        "type": "number",
        "defaultValue": "50"
      }
    ]
  }
}
