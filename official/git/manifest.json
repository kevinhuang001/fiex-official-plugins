{
  "schemaVersion": 1,
  "id": "org.fiex.git",
  "name": "Git",
  "version": "0.1.0",
  "protocolVersion": "1.0",
  "capabilities": [
    "filesystem",
    "toolbar",
    "commands",
    "panel"
  ],
  "entrypoints": {
    "windows-x86_64": "fiex-plugin-git.exe",
    "macos-aarch64": "fiex-plugin-git",
    "macos-x86_64": "fiex-plugin-git",
    "linux-x86_64": "fiex-plugin-git"
  },
  "contributes": {
    "toolbar": [
      {
        "id": "git.main",
        "title": "源代码管理",
        "icon": "git-branch",
        "command": "git.status"
      }
    ],
    "settings": [
      {
        "id": "historyLimit",
        "label": "历史提交显示条数",
        "type": "number",
        "defaultValue": "50"
      }
    ],
    "vfs": {
      "schemes": [
        "history"
      ]
    }
  },
  "permissions": {
    "filesystem.read": true,
    "filesystem.write": true,
    "network": true
  },
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "description": "源代码管理、提交历史、远程仓库与只读历史浏览。",
  "networkDomains": [
    "github.com"
  ]
}
