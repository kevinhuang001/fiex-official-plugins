{
  "schemaVersion": 2,
  "id": "org.fiex.gpg",
  "name": "GPG",
  "version": "0.2.8",
  "description": "使用本机 GnuPG 加密、解密、签名、验签及管理公钥。",
  "icon": "key-round",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "3.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-gpg.exe",
      "macos-aarch64": "fiex-plugin-gpg",
      "macos-x86_64": "fiex-plugin-gpg",
      "linux-x86_64": "fiex-plugin-gpg"
    }
  },
  "permissions": {
    "commands": {
      "enabled": true,
      "allow": [
        "gpg"
      ]
    }
  },
  "extensions": {
    "contextMenus": true,
    "toolbar": [
      {
        "id": "gpg.keys",
        "title": "公钥管理",
        "icon": "key-round",
        "panel": {
          "entry": "ui/dist/index.html",
          "title": "GPG 公钥管理",
          "defaultSize": {
            "width": 420,
            "height": 460
          }
        }
      }
    ]
  }
}
