{
  "schemaVersion": 1,
  "id": "org.fiex.office-preview",
  "name": "Office 预览",
  "version": "0.2.10",
  "description": "Word、Excel、PowerPoint 的只读预览。文本级渲染，复杂版式会简化。",
  "icon": "file-text",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "2.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-office-preview.exe",
      "macos-aarch64": "fiex-plugin-office-preview",
      "macos-x86_64": "fiex-plugin-office-preview",
      "linux-x86_64": "fiex-plugin-office-preview"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": false
      },
      "create": false,
      "delete": false,
      "rename": false
    },
    "files": {
      "read": true,
      "write": false
    },
    "network": {
      "enabled": false,
      "domains": []
    },
    "commands": {
      "enabled": false,
      "allow": []
    }
  },
  "contributions": {
    "preview": [
      {
        "id": "office",
        "title": "Office 预览",
        "extensions": [
          "docx",
          "xlsx",
          "pptx"
        ],
        "priority": 100,
        "maxBytes": 33554432,
        "panel": {
          "entry": "ui/index.html",
          "title": "Office 预览",
          "defaultSize": {
            "width": 720,
            "height": 600
          }
        }
      }
    ]
  }
}
