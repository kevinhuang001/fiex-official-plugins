{
  "schemaVersion": 2,
  "id": "org.fiex.office-preview",
  "name": "Office",
  "version": "0.3.3",
  "description": "Word、Excel、PowerPoint 的只读预览，并可将 DOCX、XLSX、PPTX 导出为 PDF。预览和转换均由插件内 Rust 实现，不依赖 Microsoft Office 或外部转换器。",
  "icon": "file-text",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "7.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-office-preview.exe",
      "macos-aarch64": "fiex-plugin-office-preview",
      "macos-x86_64": "fiex-plugin-office-preview",
      "linux-x86_64": "fiex-plugin-office-preview"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": false
      },
      "create": {
        "enabled": true
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "network": {
      "enabled": false,
      "domains": []
    },
    "commands": {
      "enabled": false,
      "allow": []
    },
    "metadata": {
      "enabled": true
    }
  },
  "extensions": {
    "preview": {
      "priority": 100,
      "maxBytes": 536870912,
      "match": {
        "extensions": [
          "docx",
          "xlsx",
          "pptx"
        ]
      },
      "loading": {
        "entry": "ui/loading.html"
      }
    },
    "info": {
      "priority": 100,
      "match": {
        "extensions": [
          "docx",
          "xlsx",
          "pptx"
        ]
      },
      "sections": [
        {
          "id": "office",
          "title": "文档",
          "fields": [
            {
              "id": "format",
              "label": "格式",
              "compute": "onOpen"
            },
            {
              "id": "paragraphs",
              "label": "段落",
              "compute": "onDemand"
            },
            {
              "id": "headings",
              "label": "标题",
              "compute": "onDemand"
            },
            {
              "id": "tables",
              "label": "表格",
              "compute": "onDemand"
            },
            {
              "id": "images",
              "label": "图片",
              "compute": "onDemand"
            },
            {
              "id": "listItems",
              "label": "列表项",
              "compute": "onDemand"
            }
          ]
        }
      ]
    },
    "settings": [
      {
        "id": "previewPages",
        "label": "预览页数",
        "type": "number",
        "defaultValue": 6,
        "placeholder": "6"
      }
    ],
    "contextMenus": {
      "match": {
        "extensions": [
          "docx",
          "xlsx",
          "pptx"
        ],
        "exclude": {
          "view": {
            "providerIds": [
              "core:applications",
              "core:trash",
              "core:recent"
            ]
          }
        }
      }
    }
  },
  "locales": {
    "en": {
      "Office": "Office",
      "预览页数": "Preview page limit",
      "Word、Excel、PowerPoint 的只读预览，并可将 DOCX、XLSX、PPTX 导出为 PDF。预览和转换均由插件内 Rust 实现，不依赖 Microsoft Office 或外部转换器。": "Read-only Word, Excel and PowerPoint preview, with PDF export for DOCX, XLSX and PPTX. Rendering and conversion run in the Rust plugin without Microsoft Office or external converters.",
      "文档": "Document",
      "格式": "Format",
      "段落": "Paragraphs",
      "标题": "Headings",
      "表格": "Tables",
      "图片": "Images",
      "列表项": "List items"
    },
    "zh-TW": {
      "Office": "Office",
      "预览页数": "預覽頁數",
      "Word、Excel、PowerPoint 的只读预览，并可将 DOCX、XLSX、PPTX 导出为 PDF。预览和转换均由插件内 Rust 实现，不依赖 Microsoft Office 或外部转换器。": "Word、Excel、PowerPoint 唯讀預覽，並支援將 DOCX、XLSX、PPTX 匯出為 PDF。預覽和轉換均由外掛內的 Rust 實作，不依賴 Microsoft Office 或外部轉換器。",
      "文档": "文件",
      "格式": "格式",
      "段落": "段落",
      "标题": "標題",
      "表格": "表格",
      "图片": "圖片",
      "列表项": "清單項目"
    }
  }
}
