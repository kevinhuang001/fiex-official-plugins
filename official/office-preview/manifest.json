{
  "schemaVersion": 2,
  "id": "org.fiex.office-preview",
  "name": "Office 预览",
  "version": "0.2.10",
  "description": "Word、Excel、PowerPoint 的只读预览。文本级渲染，复杂版式会简化。",
  "icon": "file-text",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "3.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-office-preview.exe",
      "macos-aarch64": "fiex-plugin-office-preview",
      "macos-x86_64": "fiex-plugin-office-preview",
      "linux-x86_64": "fiex-plugin-office-preview"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "network": {
      "enabled": false,
      "domains": []
    },
    "commands": {
      "enabled": false,
      "allow": []
    },
    "metadata": {
      "enabled": true
    }
  },
  "extensions": {
    "preview": {
      "id": "office",
      "title": "Office 预览",
      "priority": 100,
      "maxBytes": 33554432,
      "match": {
        "extensions": [
          "docx",
          "xlsx",
          "pptx"
        ]
      }
    },
    "info": {
      "id": "office.info",
      "title": "文档",
      "priority": 100,
      "match": {
        "extensions": [
          "docx",
          "xlsx",
          "pptx"
        ]
      }
    }
  }
}
