{
  "schemaVersion": 2,
  "id": "org.fiex.office-preview",
  "name": "Office 预览",
  "version": "0.2.13",
  "description": "Word、Excel、PowerPoint 的只读预览。文本级渲染，复杂版式会简化。",
  "icon": "file-text",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "6.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-office-preview.exe",
      "macos-aarch64": "fiex-plugin-office-preview",
      "macos-x86_64": "fiex-plugin-office-preview",
      "linux-x86_64": "fiex-plugin-office-preview"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "network": {
      "enabled": false,
      "domains": []
    },
    "commands": {
      "enabled": false,
      "allow": []
    },
    "metadata": {
      "enabled": true
    }
  },
  "extensions": {
    "preview": {
      "priority": 100,
      "maxBytes": 33554432,
      "match": {
        "extensions": [
          "docx",
          "xlsx",
          "pptx"
        ],
        "requiredOps": [
          "read"
        ]
      },
      "loading": {
        "entry": "ui/loading.html"
      }
    },
    "info": {
      "priority": 100,
      "match": {
        "extensions": [
          "docx",
          "xlsx",
          "pptx"
        ],
        "requiredOps": [
          "read"
        ]
      }
    },
    "settings": [
      {
        "id": "previewPages",
        "label": "预览页数",
        "type": "number",
        "defaultValue": 6,
        "placeholder": "6"
      }
    ]
  },
  "locales": {
    "en": {
      "Office 预览": "Office Preview",
      "Word、Excel、PowerPoint 的只读预览。文本级渲染，复杂版式会简化。": "Read-only Word, Excel and PowerPoint preview. Complex layouts are simplified.",
      "预览页数": "Preview page limit"
    },
    "zh-TW": {
      "Office 预览": "Office 預覽",
      "Word、Excel、PowerPoint 的只读预览。文本级渲染，复杂版式会简化。": "Word、Excel、PowerPoint 的唯讀預覽。文字層級渲染，複雜版面會簡化。",
      "预览页数": "預覽頁數"
    }
  }
}
