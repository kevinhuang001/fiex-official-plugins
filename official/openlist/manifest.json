{
  "schemaVersion": 2,
  "id": "org.fiex.openlist",
  "name": "OpenList",
  "version": "0.3.0",
  "description": "通过 OpenList 原生 API 连接服务器，支持目录浏览与文件读取。",
  "icon": "cloud",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "6.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-openlist.exe",
      "macos-aarch64": "fiex-plugin-openlist",
      "macos-x86_64": "fiex-plugin-openlist",
      "linux-x86_64": "fiex-plugin-openlist"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "network": {
      "enabled": true,
      "domains": []
    },
    "commands": {
      "enabled": false,
      "allow": []
    },
    "metadata": {
      "enabled": true
    }
  },
  "extensions": {
    "connections": {
      "title": "OpenList",
      "fields": [
        {
          "id": "url",
          "label": "服务器地址",
          "type": "url",
          "required": true,
          "placeholder": "http://localhost:5244"
        },
        {
          "id": "username",
          "label": "用户名",
          "type": "text"
        },
        {
          "id": "password",
          "label": "密码",
          "type": "secret"
        },
        {
          "id": "timeout",
          "label": "连接超时（秒）",
          "type": "number",
          "defaultValue": "30"
        }
      ]
    },
    "vfs": {
      "title": "OpenList"
    }
  },
  "locales": {
    "en": {
      "密码": "Password",
      "服务器地址": "Server URL",
      "用户名": "Username",
      "连接超时（秒）": "Connection timeout (seconds)",
      "通过 OpenList 原生 API 连接服务器，支持目录浏览与文件读取。": "Connect using the OpenList API, browse directories and read files."
    },
    "zh-TW": {
      "密码": "密碼",
      "服务器地址": "伺服器位址",
      "用户名": "使用者名稱",
      "连接超时（秒）": "連線逾時（秒）",
      "通过 OpenList 原生 API 连接服务器，支持目录浏览与文件读取。": "透過 OpenList 原生 API 連線至伺服器，支援目錄瀏覽與檔案讀取。"
    }
  }
}
