{
  "schemaVersion": 2,
  "id": "org.fiex.smb",
  "name": "SMB / NAS",
  "version": "0.3.0",
  "description": "通过独立进程连接 SMB / NAS 共享。",
  "icon": "hard-drive",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "3.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-smb.exe",
      "macos-aarch64": "fiex-plugin-smb",
      "macos-x86_64": "fiex-plugin-smb",
      "linux-x86_64": "fiex-plugin-smb"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "network": {
      "enabled": true,
      "domains": [
        "localhost"
      ]
    },
    "commands": {
      "enabled": false,
      "allow": []
    },
    "metadata": {
      "enabled": true
    }
  },
  "extensions": {
    "settings": [
      {
        "id": "scanInterval",
        "label": "目录扫描间隔（秒）",
        "type": "number",
        "defaultValue": "90"
      }
    ],
    "connections": [
      {
        "id": "smb",
        "title": "SMB 网络共享",
        "fields": [
          {
            "id": "host",
            "label": "主机",
            "type": "text",
            "required": true,
            "placeholder": "nas.local"
          },
          {
            "id": "port",
            "label": "端口",
            "type": "number",
            "defaultValue": "445"
          },
          {
            "id": "share",
            "label": "共享名",
            "type": "text",
            "required": true,
            "placeholder": "Public"
          },
          {
            "id": "base",
            "label": "子路径",
            "type": "text"
          },
          {
            "id": "username",
            "label": "用户名",
            "type": "text"
          },
          {
            "id": "password",
            "label": "密码",
            "type": "secret"
          }
        ]
      }
    ],
    "vfs": [
      {
        "id": "smb",
        "title": "SMB / NAS"
      }
    ]
  }
}
