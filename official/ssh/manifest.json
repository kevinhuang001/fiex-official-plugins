{
  "schemaVersion": 2,
  "id": "org.fiex.ssh",
  "name": "SSH",
  "version": "0.1.1",
  "description": "SSH 连接插件：通过 SDK TCP Broker 建立连接，在独立 PluginView 中渲染终端。",
  "icon": "terminal",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "5.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-ssh.exe",
      "macos-aarch64": "fiex-plugin-ssh",
      "macos-x86_64": "fiex-plugin-ssh",
      "linux-x86_64": "fiex-plugin-ssh"
    }
  },
  "permissions": {
    "network": {
      "enabled": true,
      "all": true,
      "domains": []
    }
  },
  "extensions": {
    "connections": {
      "title": "SSH",
      "fields": [
        {
          "id": "host",
          "label": "主机",
          "type": "text",
          "required": true,
          "placeholder": "server.example.com"
        },
        {
          "id": "port",
          "label": "端口",
          "type": "number",
          "defaultValue": 22
        },
        {
          "id": "username",
          "label": "用户名",
          "type": "text",
          "placeholder": "root"
        },
        {
          "id": "privateKey",
          "label": "私钥内容（可选）",
          "type": "secret",
          "multiline": true
        },
        {
          "id": "passphrase",
          "label": "私钥口令（可选）",
          "type": "secret"
        },
        {
          "id": "terminalType",
          "label": "终端类型",
          "type": "text",
          "defaultValue": "xterm-256color"
        },
        {
          "id": "password",
          "label": "密码（可选，也可使用私钥）",
          "type": "secret"
        }
      ]
    }
  }
}
