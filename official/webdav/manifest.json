{
  "schemaVersion": 1,
  "id": "org.fiex.webdav",
  "name": "WebDAV",
  "version": "0.2.4",
  "description": "通过独立进程连接 WebDAV 服务器，目录按需读取。",
  "icon": "cloud",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "2.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-webdav.exe",
      "macos-aarch64": "fiex-plugin-webdav",
      "macos-x86_64": "fiex-plugin-webdav",
      "linux-x86_64": "fiex-plugin-webdav"
    }
  },
  "permissions": {
    "filesystem": {
      "read": true,
      "write": false
    },
    "network": {
      "enabled": true,
      "domains": []
    }
  },
  "contributions": {
    "settings": [
      {
        "id": "timeout",
        "label": "连接超时（秒）",
        "type": "number",
        "defaultValue": "90"
      },
      {
        "id": "cacheMetadataTtl",
        "label": "目录刷新周期（秒）",
        "type": "number",
        "defaultValue": "60"
      }
    ],
    "connections": [
      {
        "id": "webdav",
        "title": "WebDAV",
        "fields": [
          {
            "id": "url",
            "label": "服务器地址",
            "type": "url",
            "required": true,
            "placeholder": "https://example.com/dav"
          },
          {
            "id": "username",
            "label": "用户名",
            "type": "text"
          },
          {
            "id": "password",
            "label": "密码",
            "type": "secret"
          },
          {
            "id": "allowInvalidCerts",
            "label": "允许自签名证书",
            "type": "checkbox"
          }
        ]
      }
    ]
  }
}
