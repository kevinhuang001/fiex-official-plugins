{
  "schemaVersion": 2,
  "id": "org.fiex.webdav",
  "name": "WebDAV",
  "version": "0.3.1",
  "description": "通过独立进程连接 WebDAV 服务器，目录按需读取。",
  "icon": "cloud",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "6.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-webdav.exe",
      "macos-aarch64": "fiex-plugin-webdav",
      "macos-x86_64": "fiex-plugin-webdav",
      "linux-x86_64": "fiex-plugin-webdav"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "network": {
      "enabled": true,
      "domains": [
        "localhost"
      ]
    },
    "commands": {
      "enabled": false,
      "allow": []
    },
    "metadata": {
      "enabled": true
    }
  },
  "extensions": {
    "settings": [
      {
        "id": "timeout",
        "label": "连接超时（秒）",
        "type": "number",
        "defaultValue": "90"
      },
      {
        "id": "cacheMetadataTtl",
        "label": "目录刷新周期（秒）",
        "type": "number",
        "defaultValue": "60"
      }
    ],
    "connections": {
      "title": "WebDAV",
      "fields": [
        {
          "id": "url",
          "label": "服务器地址",
          "type": "url",
          "required": true,
          "placeholder": "https://example.com/dav"
        },
        {
          "id": "username",
          "label": "用户名",
          "type": "text"
        },
        {
          "id": "password",
          "label": "密码",
          "type": "secret"
        },
        {
          "id": "allowInvalidCerts",
          "label": "允许自签名证书",
          "type": "checkbox"
        }
      ]
    },
    "vfs": {
      "title": "WebDAV"
    }
  },
  "locales": {
    "en": {
      "允许自签名证书": "Allow self-signed certificates",
      "密码": "Password",
      "服务器地址": "Server URL",
      "用户名": "Username",
      "目录刷新周期（秒）": "Directory refresh interval (seconds)",
      "连接超时（秒）": "Connection timeout (seconds)",
      "通过独立进程连接 WebDAV 服务器，目录按需读取。": "Connect to WebDAV servers in an isolated process with on-demand directory listing."
    },
    "zh-TW": {
      "允许自签名证书": "允許自簽憑證",
      "密码": "密碼",
      "服务器地址": "伺服器位址",
      "用户名": "使用者名稱",
      "目录刷新周期（秒）": "目錄重新整理週期（秒）",
      "连接超时（秒）": "連線逾時（秒）",
      "通过独立进程连接 WebDAV 服务器，目录按需读取。": "透過獨立程序連線至 WebDAV 伺服器，目錄隨選讀取。"
    }
  }
}
