{
  "schemaVersion": 2,
  "id": "org.fiex.webdav",
  "name": "WebDAV",
  "version": "0.3.0",
  "description": "通过独立进程连接 WebDAV 服务器，目录按需读取。",
  "icon": "cloud",
  "author": {
    "name": "Fiex Contributors",
    "url": "https://github.com/kevinhuang001/fiex-official-plugins"
  },
  "runtime": {
    "protocolVersion": "5.0",
    "entrypoints": {
      "windows-x86_64": "fiex-plugin-webdav.exe",
      "macos-aarch64": "fiex-plugin-webdav",
      "macos-x86_64": "fiex-plugin-webdav",
      "linux-x86_64": "fiex-plugin-webdav"
    }
  },
  "permissions": {
    "folders": {
      "read": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "files": {
      "read": {
        "enabled": true
      },
      "write": {
        "enabled": false
      },
      "create": {
        "enabled": false
      },
      "delete": {
        "enabled": false
      },
      "rename": {
        "enabled": false
      }
    },
    "network": {
      "enabled": true,
      "domains": [
        "localhost"
      ]
    },
    "commands": {
      "enabled": false,
      "allow": []
    },
    "metadata": {
      "enabled": true
    }
  },
  "extensions": {
    "settings": [
      {
        "id": "timeout",
        "label": "连接超时（秒）",
        "type": "number",
        "defaultValue": "90"
      },
      {
        "id": "cacheMetadataTtl",
        "label": "目录刷新周期（秒）",
        "type": "number",
        "defaultValue": "60"
      }
    ],
    "connections": {
      "title": "WebDAV",
      "fields": [
        {
          "id": "url",
          "label": "服务器地址",
          "type": "url",
          "required": true,
          "placeholder": "https://example.com/dav"
        },
        {
          "id": "username",
          "label": "用户名",
          "type": "text"
        },
        {
          "id": "password",
          "label": "密码",
          "type": "secret"
        },
        {
          "id": "allowInvalidCerts",
          "label": "允许自签名证书",
          "type": "checkbox"
        }
      ]
    },
    "vfs": {
      "title": "WebDAV"
    }
  }
}
